# MySQL MCP Server — copy to .env and fill in the connection block below.
# This file (in the repo root) is the single source of credentials: the server
# reads it from its own location, and it overrides any env the MCP client passes.

# --- Connection (required) ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=user
MYSQL_PASSWORD=password
MYSQL_DATABASE=database

# --- Connection alternatives (use instead of the block above) ---
# In a DSN the password must be percent-encoded (# -> %23, / -> %2F, ? -> %3F,
# % -> %25) or startup fails with "Invalid URL". The block above needs no encoding
# — just quote any value containing # so it is not read as a comment.
# MYSQL_DSN=mysql://user:password@localhost:3306/database
# Named connections, switchable at runtime via use_connection.
# Replaces the block above entirely — a "default" entry is required.
# MYSQL_CONNECTIONS={"default":{"dsn":"mysql://user:pass@localhost:3306/app"},"staging":{"dsn":"mysql://user:pass@staging-db:3306/app"}}

# --- Tools ---
# Enable the 11 extended tools — 22 total instead of 11 (default: false)
MYSQL_MCP_EXTENDED=false

# --- Query limits ---
MYSQL_MAX_ROWS=200
MYSQL_MCP_QUERY_TIMEOUT=30

# --- Logging ---
# MYSQL_MCP_LOG_LEVEL=info          # debug | info | warn | error
# MYSQL_MCP_JSON_LOGS=false
# MYSQL_MCP_SILENT=false            # suppress all log output
# MYSQL_MCP_AUDIT_LOG=./audit.jsonl # JSONL trail of executed queries

# --- HTTP transport (default: stdio/MCP mode) ---
# MYSQL_MCP_HTTP=false
# MYSQL_MCP_HTTP_PORT=3000
# MYSQL_MCP_API_KEY=your-secret-key # requires: Authorization: Bearer <key>
# MYSQL_MCP_RATE_LIMIT_ENABLED=false
# MYSQL_MCP_RATE_LIMIT_RPS=10
# MYSQL_MCP_RATE_LIMIT_BURST=20

# --- SSH tunnel (database behind a bastion) ---
# MYSQL_MCP_SSH_HOST=bastion.example.com
# MYSQL_MCP_SSH_PORT=22
# MYSQL_MCP_SSH_USER=ubuntu
# MYSQL_MCP_SSH_KEY_PATH=~/.ssh/id_rsa
